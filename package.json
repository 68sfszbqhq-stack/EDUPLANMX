{
  "name": "eduplan-mx",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "./deploy.sh",
    "respaldo": "tsx scripts/respaldo_firestore.ts",
    "prueba:generacion": "tsx scripts/prueba-generacion.ts",
    "extraer:laboral": "tsx scripts/extraer_laboral.ts",
    "prueba:fusion": "tsx scripts/prueba-fusion-bitacora.ts",
    "test:cuaderno": "node --import tsx --test scripts/cuaderno.test.ts",
    "dev:v2": "vite --config vite.v2.config.ts",
    "test:reglas": "PATH=/opt/homebrew/opt/openjdk/bin:$PATH firebase emulators:exec --only firestore --project demo-eduplan-reglas 'node --import tsx --test scripts/reglas.test.ts'",
    "test:grupos": "node --import tsx --test scripts/grupos.test.ts",
    "test:reglas-compartidas": "node scripts/combinar-reglas.mjs && PATH=/opt/homebrew/opt/openjdk/bin:$PATH firebase emulators:exec --only firestore --project demo-eduplan-compartidas 'node --import tsx --test scripts/reglas-compartidas.test.ts'",
    "emulador": "node scripts/combinar-reglas.mjs && PATH=/opt/homebrew/opt/openjdk/bin:$PATH firebase emulators:start --config firebase.emulador.json --project eduplanmx-pruebas",
    "dev:v2:emulador": "VITE_EMULADOR=1 vite --config vite.v2.config.ts",
    "test:evaluacion": "node --import tsx --test scripts/evaluacion.test.ts",
    "test:clase": "node --import tsx --test scripts/clase.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.35.0",
    "docx": "^9.7.1",
    "firebase": "^12.7.0",
    "jszip": "3.10.1",
    "lucide-react": "^0.562.0",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "react-to-print": "^3.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^25.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.18",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.4"
  }
}
